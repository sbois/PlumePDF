# PlumePDF — relever les limites d'upload PHP pour ce dossier uniquement
# Sans cela, les photos iPhone (10-20 Mo chacune) saturent rapidement la limite par défaut (8 Mo).

<IfModule mod_php.c>
    php_value upload_max_filesize 128M
    php_value post_max_size       256M
    php_value max_file_uploads    60
    php_value max_execution_time  300
    php_value memory_limit        512M
</IfModule>

<IfModule mod_php7.c>
    php_value upload_max_filesize 128M
    php_value post_max_size       256M
    php_value max_file_uploads    60
    php_value max_execution_time  300
    php_value memory_limit        512M
</IfModule>

<IfModule mod_php8.c>
    php_value upload_max_filesize 128M
    php_value post_max_size       256M
    php_value max_file_uploads    60
    php_value max_execution_time  300
    php_value memory_limit        512M
</IfModule>
